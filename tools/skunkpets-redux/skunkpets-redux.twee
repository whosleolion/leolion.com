:: func-back {"position":"100,725","size":"100,100"}
{(if: $navHistory's length > 0)[
(set: _navBack to $navHistory's last)
(set: $navHistory to (subarray: $navHistory, 1, $navHistory's length - 1))
(set: $navForward to (a: $browserPage) + $navForward)
(set: $browserPage to _navBack)
(set: $starbarOpen to false)
(replace: ?desktoproot)[(display: "RenderDesktop")]
]}

:: func-forward {"position":"225,725","size":"100,100"}
{(if: $navForward's length > 0)[
(set: _navTarget to $navForward's 1st)
(set: $navHistory to $navHistory + (a: $browserPage))
(if: $navForward's length is 1)[(set: $navForward to (a:))](else:)[(set: $navForward to (subarray: $navForward, 2, $navForward's length))]
(set: $browserPage to _navTarget)
(set: $starbarOpen to false)
(replace: ?desktoproot)[(display: "RenderDesktop")]
]}

:: func-navigate {"position":"350,725","size":"100,100"}
{(if: $navPending is not $browserPage)[
  (if: $navHistory's length is 0 or $navHistory's last is not $browserPage)[
    (set: $navHistory to $navHistory + (a: $browserPage))
  ]
  (set: $navForward to (a:))
  (set: $browserPage to $navPending)
]
(set: $starbarOpen to false)
(replace: ?desktoproot)[(display: "RenderDesktop")]}


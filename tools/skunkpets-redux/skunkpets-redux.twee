(link-repeat: "trash:diskette")[(set: $trashPending to "diskette")(display: "func-trash")]
(link-repeat: "restore:readme")[(set: $restorePending to "readme")(display: "func-restore")]
(link-repeat: "trash:browser")[(set: $trashPending to "browser")(display: "func-trash")]
(link-repeat: "trash:mail")[(set: $trashPending to "mail")(display: "func-trash")]
(link-repeat: "trash:notes")[(set: $trashPending to "notes")(display: "func-trash")]
(link-repeat: "trash:readme")[(set: $trashPending to "readme")(display: "func-trash")]
(link-repeat: "trash-hint")[(set: $dialog to "This item is in the Trash. To use it, drag it out onto the desktop first.")(set: $dialogTitle to "Trash")(set: $dialogIcon to "info")(set: $dialogOk to "OK")(set: $dialogAction to "")(set: $dialogCancel to false)(replace: ?desktoproot)[(display: "RenderDesktop")]]
</div>

:: func-restore
{(set: $trashItems to it - (a: $restorePending))
(unless: $desktopItems contains $restorePending)[(set: $desktopItems to it + (a: $restorePending))]
(if: $openWindows contains "diskette" and not $disketteShown and (a: "browser", "mail", "notes") contains $restorePending)[(set: $disketteNotice to $restorePending)]
(replace: ?desktoproot)[(display: "RenderDesktop")]}

:: Winkipedia [wiki]
{<div class="winki">
<div class="winki-logo"><div class="winki-name">Winkipedia</div><div class="winki-tag">The Free Encyclopedia</div></div>
<div class="winki-search"><input type="text" id="winki-search-input" autocomplete="off" spellcheck="false" placeholder="Search Winkipedia"><button type="button" id="winki-search-btn" class="xp-button">Search</button></div>
<div class="winki-msg" id="winki-msg"></div>
<span class="winki-nav" style="display:none">(link: "·")[(set: $navPending to "Skunkpets")(display: "func-navigate")]</span>
<div class="winki-index" hidden>(display: "WinkiIndex")</div>
<span class="winki-web-nav" style="display:none">(link: "·")[(set: $navPending to "Winkipedia Search Result")(display: "func-navigate")]</span>
</div>}

:: Skunkpets.com [wiki]
{<div class="http-404">
<h1>404 Not Found</h1>
<p>The page you are looking for no longer exists.</p>
<p>The requested URL http://www.skunkpets.com/ was not found on this server.</p>
<hr>
<address>Apache/2.2.14 (Unix) Server at www.skunkpets.com Port 80</address>
</div>}

:: func-trash
{(set: $desktopItems to it - (a: $trashPending))
(unless: $trashItems contains $trashPending)[(set: $trashItems to it + (a: $trashPending))]
(set: $openWindows to it - (a: $trashPending))
(if: $trashPending is "diskette")[(set: $disketteShown to false)(set: $disketteNotice to "")]
(replace: ?desktoproot)[(display: "RenderDesktop")]}

:: Winkipedia Search Result [wiki]
{<div class="winki-web">
<div class="winki-web-bar"><span class="winki-web-brand">Winkipedia</span> <span class="winki-web-title" id="winki-web-title"></span></div>
<iframe class="winki-web-frame" id="winki-web-frame" sandbox="allow-scripts allow-same-origin allow-popups" referrerpolicy="no-referrer"></iframe>
</div>}

:: RenderDiskette
{<div class="diskette-assistant">
<div class="diskette-bubble">
|diskette-close>[<button class="diskette-close" type="button" aria-label="Hide" title="Hide in the tray">&times;</button>]
(click: ?diskette-close)[(display: "func-diskette-hide")]
(if: $disketteTopic is "")[
<p>Hi there! I'm <b>Diskette</b>, Your Secretary. What would you like to know about?</p>
<div class="diskette-options">
(if: $desktopItems contains "browser")[(link: "Browse")[(set: $disketteTopic to "browser")(replace: ?desktoproot)[(display: "RenderDesktop")]]]
(if: $desktopItems contains "mail")[(link: "Mail")[(set: $disketteTopic to "mail")(replace: ?desktoproot)[(display: "RenderDesktop")]]]
(if: $desktopItems contains "notes")[(link: "Notes")[(set: $disketteTopic to "notes")(replace: ?desktoproot)[(display: "RenderDesktop")]]]
(link: "Trash")[(set: $disketteTopic to "recycle")(replace: ?desktoproot)[(display: "RenderDesktop")]]
(link: "Diskette")[(set: $disketteTopic to "diskette")(replace: ?desktoproot)[(display: "RenderDesktop")]]
</div>
(if: ($trashItems - (a: "readme"))'s length > 0)[<p class="diskette-note">There's still something in your Trash! Drag it onto the desktop and I can tell you about it too.</p>]
](else:)[
<p>(display: "DisketteTopic")</p>
<div class="diskette-options">
(link: "Tell me about something else")[(set: $disketteTopic to "")(replace: ?desktoproot)[(display: "RenderDesktop")]]
(link: "Dismiss")[(display: "func-diskette-hide")]
</div>
]
</div>
<div class="diskette-character"></div>
</div>}

:: DisketteTopic
{(if: $disketteTopic is "browser")[<b>Browse</b> is your web browser! Use the ◀ and ▶ buttons to go back and forward. The ★ button shows your bookmarks. You already have Winkipedia and Skunkpets.com saved!]
(else-if: $disketteTopic is "mail")[<b>Mail</b> is where your email arrives. Click a message in your Inbox to read it. A red badge on the Mail icon means something new came in!]
(else-if: $disketteTopic is "notes")[<b>Notes</b> is a handy notepad. Jot down anything you want to remember. Whatever you type stays put, even after you close it!]
(else-if: $disketteTopic is "recycle")[The <b>Trash</b> holds things that were thrown away. Drag an item out onto the desktop to get it back, or drag an icon onto the Trash to throw it away.]
(else-if: $disketteTopic is "diskette")[That's me! I'm <b>Diskette</b>, Your Secretary. I know all about the programs on this computer. Just ask!]}

:: func-diskette-hide
{(set: $disketteTopic to "")
(set: $disketteShown to false)
(unless: $disketteToldTray)[(set: $disketteNotice to "hello")(set: $disketteToldTray to true)]
(replace: ?desktoproot)[(display: "RenderDesktop")]}

:: func-diskette-show
{(set: $disketteShown to true)
(if: $disketteNotice is not "" and $disketteNotice is not "hello")[(set: $disketteTopic to $disketteNotice)](else:)[(set: $disketteTopic to "")]
(set: $disketteNotice to "")
(replace: ?desktoproot)[(display: "RenderDesktop")]}

:: RenderDisketteBalloon
{<div class="diskette-balloon">
|balloon-close>[<button class="diskette-balloon-close" type="button" aria-label="Close">&times;</button>]
(click: ?balloon-close)[(set: $disketteNotice to "")(replace: ?desktoproot)[(display: "RenderDesktop")]]
|balloon-body>[<div class="diskette-balloon-title"><span class="diskette-icon diskette-icon-balloon"></span>Diskette</div>
(if: $disketteNotice is "hello")[<p>I'll be right down here in the tray! Click me whenever you need me.</p>]
(else-if: $disketteNotice is "browser")[<p>Psst! I can tell you about <b>Browse</b>.</p>]
(else-if: $disketteNotice is "mail")[<p>Psst! I can tell you about <b>Mail</b>.</p>]
(else-if: $disketteNotice is "notes")[<p>Psst! I can tell you about <b>Notes</b>.</p>]
(else:)[<p>Psst! Click me!</p>]]
(click: ?balloon-body)[(display: "func-diskette-show")]
</div>}

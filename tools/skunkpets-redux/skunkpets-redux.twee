:: func-open
{(unless: $openWindows contains $openPending)[(set: $openWindows to it + (a: $openPending))]
(if: $openPending is "diskette")[(set: $disketteShown to true)(set: $disketteNotice to "")]
(set: $focusWin to $openPending)
(set: $focusSeq to it + 1)
(set: $startOpen to false)
(replace: ?desktoproot)[(display: "RenderDesktop")]}

:: func-dialog-ok
{(set: _action to $dialogAction)
(set: $dialog to "")
(set: $dialogAction to "")
(if: _action is "openmail")[
  (set: $openPending to "mail")
  (display: "func-open")
](else-if: _action is "devlink")[
  (unless: $openWindows contains "browser")[(set: $openWindows to it + (a: "browser"))]
  (set: $navPending to "devlink-userbase: login")
  (display: "func-navigate")
](else:)[
  (replace: ?desktoproot)[(display: "RenderDesktop")]
]}

:: DesktopActions
<div class="js-actions" hidden>
(link-repeat: "restore:browser")[(set: $restorePending to "browser")(display: "func-restore")]
(link-repeat: "restore:mail")[(set: $restorePending to "mail")(display: "func-restore")]
